function selectedPolygon() {
  if (!draw) return null;

  const fs = getAllDrawn().features;
  const ids = draw.getSelectedIds();
  const candidates = ids.length ? fs.filter(f => ids.includes(f.id)) : fs;

  return candidates.find(f =>
    f.geometry &&
    (f.geometry.type === 'Polygon' || f.geometry.type === 'MultiPolygon')
  ) || null;
}

function refreshStats() {
  const f = selectedPolygon();

  if (!f) {
    $('drawStats').textContent = 'Выберите или нарисуйте полигон, чтобы рассчитать площадь.';
    return;
  }

  try {
    const area = window.turf ? turf.area(f) : 0;
    const ha = area / 10000;
    const perimeter = window.turf
      ? turf.length(turf.polygonToLine(f), { units: 'kilometers' })
      : 0;

    $('drawStats').innerHTML =
      '<b>' + escapeHtml(f.properties?.name || 'Участок') + '</b>
' +
      'Площадь: ' + formatArea(area) + ' (' + ha.toFixed(2) + ' га)
' +
      'Периметр: ' + perimeter.toFixed(2) + ' км';

  } catch (e) {
    $('drawStats').textContent = 'Не удалось рассчитать геометрию.';
  }
}

function formatArea(m2) {
  return m2 >= 1e6
    ? (m2 / 1e6).toFixed(3) + ' км²'
    : Math.round(m2).toLocaleString('ru-RU') + ' м²';
}

function escapeHtml(s) {
  return String(s).replace(/[&<>"']/g, c => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '''
  }[c]));
}

