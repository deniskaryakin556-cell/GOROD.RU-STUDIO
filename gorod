function refreshMaskStyle() {
  if (!draw) return;

  const ids = draw.getSelectedIds();
  if (!ids.length) return;

  const f = draw.get(ids[0]);
  if (!f) return;

  const color = $('maskColor').value;
  const opacity = Number($('maskOpacity').value) / 100;

  const props = {
    ...(f.properties || {}),
    maskColor: color,
    maskOpacity: opacity,
    name: $('maskName').value.trim() || f.properties?.name || 'Маска'
  };

  draw.setFeatureProperty(f.id, 'maskColor', props.maskColor);
  draw.setFeatureProperty(f.id, 'maskOpacity', props.maskOpacity);
  draw.setFeatureProperty(f.id, 'name', props.name);
}

