$('fileInput').addEventListener('change', async e => {
  const file = e.target.files?.[0];
  if (!file) return;

  try {
    const d = JSON.parse(await file.text());

    if (!['gorod-ru-planning-project', 'gorod-ru-project'].includes(d.format)) {
      throw new Error('Неподдерживаемый формат проекта');
    }

    $('projectName').value = safeName(d.name);

    if (d.layers) {
      Object.entries(d.layers).forEach(([k, v]) => {
        if ($(k)) $(k).checked = !!v;
      });
    }

    if (d.style) {
      $('maskColor').value = d.style.maskColor || '#e5a64b';
      $('maskOpacity').value = d.style.maskOpacity || 35;
      $('opacityValue').textContent = $('maskOpacity').value + '%';
      $('maskName').value = d.style.maskName || '';
    }

    if (d.city && CITIES[d.city]) activeCity = d.city;

    if (d.camera && map) {
      map.jumpTo({
        center: d.camera.center || CITIES[activeCity],
        zoom: d.camera.zoom || 12,
        pitch: d.camera.pitch || 0,
        bearing: d.camera.bearing || 0
      });
    }

    if (draw && d.drawing) {
      draw.deleteAll();
      (d.drawing.features || []).forEach(f => {
        try { draw.add(f); } catch (_) {}
      });
    }

    if (d.buffer && map?.getSource('analysis-buffer')) {
      map.getSource('analysis-buffer').setData(d.buffer);
    }

    applyLayerVisibility();
    refreshStats();
    setStatus('Проект загружен: ' + safeName(d.name));

  } catch (err) {
    setStatus('Ошибка открытия проекта: ' + err.message, true);
  } finally {
    e.target.value = '';
  }
});

