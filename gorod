    'Предложи структуру градостроительного анализа для этого участка.';

  return 'Ты — помощник градостроителя и городского аналитика. ' +
    'Помоги с предварительным анализом, укажи допущения и какие данные ' +
    'необходимо проверить в официальных источниках. Не выдавай предположения ' +
    'за нормативные выводы.\n\n' +
    'Задача пользователя: ' + q + '\n\n' +
    'Контекст проекта:\n' +
    'Название: ' + d.name + '\n' +
    'Город: ' + d.city + '\n' +
    'Площадь выбранного полигона: ' + area + '\n' +
    'Камера: ' + JSON.stringify(d.camera) + '\n' +
    'Видимые слои: ' + JSON.stringify(d.layers) + '\n' +
    'Количество нарисованных объектов: ' +
    (d.drawing?.features?.length || 0) + '\n\n' +
    'Сформируй практические рекомендации, перечень нужных данных, ' +
    'методику анализа и ограничения результата.';
}

$('askAI').addEventListener('click', () => {
  const prompt = buildAIPrompt();

  try {
    const url = 'https://chatgpt.com/?q=' + encodeURIComponent(prompt);
    window.open(url, '_blank', 'noopener,noreferrer');

    setStatus(
      'Подготовлен запрос с контекстом проекта. ' +
      'Если ChatGPT не открылся, нажмите «Скопировать запрос».'
    );

  } catch (e) {
    setStatus('Не удалось открыть ChatGPT — скопируйте запрос вручную.', true);
  }
});

$('copyAIPrompt').addEventListener('click', async () => {
  const p = buildAIPrompt();

  try {
    await navigator.clipboard.writeText(p);
    setStatus('Контекст проекта и вопрос скопированы.');

  } catch (e) {
    const ta = document.createElement('textarea');
    ta.value = p;
    document.body.appendChild(ta);
    ta.select();

    const ok = document.execCommand('copy');
    ta.remove();

    setStatus(
      ok ? 'Запрос скопирован.' :
      'Не удалось скопировать. Откройте приложение через HTTPS и попробуйте снова.',
      !ok
    );
  }
});

$('newProject').addEventListener('click', () => {
  if (!confirm('Создать новый проект? Несохранённые рисунки будут удалены.')) {
    return;
  }

  if (draw) draw.deleteAll();

  analysisBuffer = null;

  if (map?.getSource('analysis-buffer')) {
    map.getSource('analysis-buffer').setData({
      type: 'FeatureCollection',
      features: []
    });
  }

  $('projectName').value = 'Градостроительный анализ';
  $('maskName').value = '';

  $('analysisResult').textContent =
    'Нарисуйте полигон и нажмите «Анализ участка».';

  ['roads', 'buildings', 'green', 'water', 'labels'].forEach(id => {
    $(id).checked = true;
  });

  $('threeD').checked = false;

  applyLayerVisibility();
  goCity('Новосибирск');
  setStatus('Создан новый проект.');
});

createMap();
})();
</script>
