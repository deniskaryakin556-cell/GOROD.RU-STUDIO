async function findGreenSpaces() {
  if (!map) return;

  if (placesController) placesController.abort();

  placesController = new AbortController();
  $('parksBtn').disabled = true;
  setStatus('Ищем парки, сады и леса в текущем районе…');
  clearPlaceMarkers();

  try {
    const b = map.getBounds();
    const south = b.getSouth();
    const west = b.getWest();
    const north = b.getNorth();
    const east = b.getEast();

    const query =
      '[out:json][timeout:18];(' +
      'nwr[leisure~"^(park|garden|nature_reserve|recreation_ground)$"](' +
      south + ',' + west + ',' + north + ',' + east + ');' +
      'nwr[landuse~"^(forest|grass|meadow|village_green)$"](' +
      south + ',' + west + ',' + north + ',' + east + ');' +
      'nwr[natural~"^(wood|scrub)$"](' +
      south + ',' + west + ',' + north + ',' + east + ');' +
      'nwr[boundary="protected_area"](' +
      south + ',' + west + ',' + north + ',' + east + ');' +
      ');out center tags 100;';

    const endpoints = [
      'https://overpass-api.de/api/interpreter',
      'https://overpass.kumi.systems/api/interpreter'
    ];

    let data = null;
    let lastErr = null;

    for (const endpoint of endpoints) {
      try {
        const r = await fetch(endpoint, {
          method: 'POST',
          body: query,
          signal: placesController.signal,
          headers: { 'Content-Type': 'text/plain;charset=UTF-8' }
        });

        if (!r.ok) throw new Error('Overpass ' + r.status);

        data = await r.json();
        break;

      } catch (e) {
        if (e.name === 'AbortError') throw e;
        lastErr = e;
      }
    }

    if (!data) throw lastErr || new Error('Сервер данных недоступен');

    const seen = new Set();
    const items = [];

    for (const el of data.elements || []) {
      const tags = el.tags || {};
      const name =
        tags.name ||
        tags['name:ru'] ||
        tags['name:en'] ||
        tags['official_name'];

      if (!name) continue;

      const key = el.type + ':' + el.id;
      if (seen.has(key)) continue;
      seen.add(key);

      const center = el.center || (
        el.lat != null ? { lat: el.lat, lon: el.lon } : null
      );

      if (!center) continue;

      items.push({
        name,
        type: tags.leisure || tags.landuse || tags.natural ||
              tags.boundary || 'зелёная зона',
        lat: center.lat,
        lon: center.lon,
        tags
      });
    }

    items.sort((a, b) => a.name.localeCompare(b.name, 'ru'));

    const list = $('placesList');
    list.replaceChildren();

    items.forEach(item


=> {
      const marker = document.createElement('div');

      marker.style.cssText =
        'width:12px;height:12px;border-radius:50%;background:#4c875b;' +
        'border:2px solid white;box-shadow:0 1px 4px #0005';

      const m = new maplibregl.Marker({ element: marker })
        .setLngLat([item.lon, item.lat])
        .setPopup(
          new maplibregl.Popup({ offset: 12 })
            .setText(item.name + ' · ' + item.type)
        )
        .addTo(map);

      placeMarkers.push(m);

      const btn = document.createElement('button');
      btn.className = 'feature-item';
      btn.textContent = item.name + ' · ' + item.type;

      btn.addEventListener('click', () => {
        map.flyTo({
          center: [item.lon, item.lat],
          zoom: 16,
          duration: 450
        });

        m.togglePopup();
      });

      list.appendChild(btn);
    });

    setStatus('Найдено именованных зелёных объектов: ' + items.length + '.');

    if (!items.length) {
      const p = document.createElement('p');
      p.className = 'small';
      p.textContent =
        'В текущем охвате не найдено именованных объектов. ' +
        'Попробуйте приблизить карту или проверить другой район.';
      list.appendChild(p);
    }

  } catch (e) {
    if (e.name !== 'AbortError') {
      setStatus('Не удалось загрузить парки и леса: ' + e.message, true);
    }
  } finally {
    $('parksBtn').disabled = false;
  }
}

function runAnalysis() {
  const f = selectedPolygon();

  if (!f) {
    $('analysisResult').textContent =
      'Нарисуйте полигон участка и выберите его.';
    return;
  }

  try {
    const area = window.turf ? turf.area(f) : 0;
    const bounds = turf.bbox(f);

    const rendered = map.queryRenderedFeatures({
      layers: map.getStyle().layers
        .map(l => l.id)
        .filter(id => map.getLayer(id) && id !== 'gorod-3d')
    });

    const unique = new Map();

    rendered.forEach(ft => {
      const k =
        (ft.source || '') + '|' +
        (ft.sourceLayer || '') + '|' +
        (ft.id ?? JSON.stringify(ft.geometry?.coordinates || []).slice(0, 80));

      if (!unique.has(k)) unique.set(k, ft);
    });

    const feats = [...unique.values()];

    let buildings = 0;
    let roads = 0;
    let green = 0;

    for (const ft of feats) {
      const c = category({
        id: ft.layer?.id || '',
        'source-layer': ft.sourceLayer || ft.layer?.['source-layer'] || ''
      });

      if (c === 'buildings') buildings++;
      if (c === 'roads') roads++;
      if (c === 'green') green++;
    }

    const lines = [];

    lines.push('<b>Предварительная сводка по участку</b>');
    lines.push(
      'Площадь: ' + formatArea(area) +
      ' (' + (area / 10000).toFixed(2) + ' га)'
    );

    lines.push(
      'Габариты охвата: ' +
      (Math.abs(bounds[2] - bounds[0]) * 111).toFixed(2) +
      ' × ' +
      (Math.abs(bounds[3] - bounds[1]) * 111).toFixed(2) +
      ' км (приблизительно)'
    );

    if ($('analysisBuildings').checked) {
      lines.push('Зданий в текущем отображении: ' + buildings);
    }

    if ($('analysisRoads').checked) {
      lines.push('Дорожных объектов в отображении: ' + roads);
    }

    if ($('analysisGreen').checked) {
      lines.push('Зелёных/землепользовательских объектов в отображении: ' + green);
    }

    lines.push(
      '<span style="color:#69736b">' +
      'Счётчики относятся к загруженным видимым тайлам вокруг карты, ' +
      'а не к точному пересечению с границей полигона. ' +
      'Для корректных площадных долей нужен GIS-слой с полной геометрией.' +
      '</span>'
    );

    $('analysisResult').innerHTML = lines.join('
');
    setStatus('Предварительный анализ рассчитан.');

  } catch (e) {
    $('analysisResult').textContent = 'Ошибка анализа: ' + e.message;
    setStatus('Ошибка анализа.', true);
  }
}

