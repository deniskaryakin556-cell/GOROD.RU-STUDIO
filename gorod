<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#f7f7f4">
<title>GOROD.RU Studio — градостроительный анализ</title>

<link rel="preconnect" href="https://tiles.openfreemap.org" crossorigin>
<link rel="preconnect" href="https://unpkg.com" crossorigin>
<link rel="preconnect" href="https://nominatim.openstreetmap.org" crossorigin>

<link rel="stylesheet" href="https://unpkg.com/maplibre-gl@5.12.0/dist/maplibre-gl.css">
<link rel="stylesheet" href="https://unpkg.com/@mapbox/mapbox-gl-draw@1.5.0/dist/mapbox-gl-draw.css">

<style>
:root {
  font-family: Inter, system-ui, -apple-system, "Segoe UI", Arial, sans-serif;
  color: #202722;
  background: #f5f6f2;
  font-synthesis: none;
  --green: #294638;
  --line: #e1e5de;
  --muted: #69736b;
}

* { box-sizing: border-box; }
body { margin: 0; }
button, input, select, textarea { font: inherit; }

button, select {
  border: 1px solid #d7ddd5;
  background: #fff;
  color: #202722;
  border-radius: 9px;
  padding: 9px 11px;
  cursor: pointer;
}

button:hover { background: #f0f3ee; }
button:disabled { opacity: .55; cursor: wait; }

.primary {
  background: var(--green);
  color: #fff;
  border-color: var(--green);
}

.danger { color: #a13c32; }

.app-header {
  min-height: 64px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 10px 16px;
  background: #fff;
  border-bottom: 1px solid var(--line);
  position: relative;
  z-index: 10;
}

.brand {
  font-weight: 850;
  letter-spacing: .08em;
  font-size: 15px;
}

.subtitle {
  font-size: 11px;
  color: var(--muted);
  margin-top: 3px;
}

.top-actions {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
}

.top-actions button {
  font-size: 12px;
  padding: 8px 10px;
}

main {
  display: grid;
  grid-template-columns: 310px minmax(0, 1fr);
  height: calc(100dvh - 65px);
  min-height: 520px;
}

.sidebar {
  background: #fff;
  border-right: 1px solid var(--line);
  overflow: auto;
  padding: 13px;
}

.section {
  border-bottom: 1px solid #edf0eb;
  padding: 0 0 14px;
  margin: 0 0 14px;
}

.section h2 {
  font-size: 11px;
  text-transform: uppercase;
  letter-spacing: .09em;
  color: var(--muted);
  margin: 0 0 10px;
}

.field {
  display: flex;
  gap: 6px;
}

.field input,
.field select,
input[type=text],
input[type=number],
textarea {
  min-width: 0;
  width: 100%;
  border: 1px solid #d7ddd5;
  border-radius: 9px;
  padding: 9px;
  background: white;
}

.field button { flex-shrink: 0; }

.small {
  font-size: 11px;
  color: var(--muted);
  line-height: 1.45;
  margin: 8px 0 0;
}

.cities {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
}

.cities button {
  font-size: 11px;
  padding: 7px 8px;
}

.checklist {
  display: grid;
  gap: 9px;
  font-size: 13px;
}

.checklist label {
  display: flex;
  gap: 8px;
  align-items: center;
}

.checklist input { accent-color: var(--green); }

.two {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 7px;
}

.btn-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 6px;
}

.btn-grid button { font-size: 12px; }

.color-row {
  display: grid;
  grid-template-columns: 1fr 54px;
  gap: 8px;
  align-items: center;
  margin: 9px 0;
}

.color-row input[type=color] {
  width: 54px;
  height: 34px;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #fff;
  padding: 2px;
}

.range-row {
  display: grid;
  grid-template-columns: 1fr 48px;
  align-items: center;
  gap: 8px;
  margin: 8px 0;
  font-size: 12px;
}

.range-row input { width: 100%; }

.result {
  background: #f5f7f3;
  border: 1px solid #e7ebe4;
  border-radius: 10px;
  padding: 10px;
  margin-top: 8px;
  font-size: 12px;
  line-height: 1.5;
}

.map-wrap {
  position: relative;
  min-width: 0;
  min-height: 0;
  background: #e9ede7;
}

#map {
  position: absolute;
  inset: 0;
}

.status {
  position: absolute;
  z-index: 4;
  bottom: 12px;
  left: 12px;
  max-


width: min(560px, calc(100% - 24px));
  padding: 9px 12px;
  border-radius: 10px;
  background: #fff;
  box-shadow: 0 2px 12px #0001;
  font-size: 12px;
  color: #59625b;
}

.status.error { color: #8c2b21; }

.loading {
  position: absolute;
  z-index: 3;
  inset: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #edf0eb;
  color: #59625b;
  font-size: 13px;
  transition: opacity .2s;
}

.loading.hidden {
  opacity: 0;
  pointer-events: none;
}

.spinner {
  width: 18px;
  height: 18px;
  border: 2px solid #ccd5cb;
  border-top-color: var(--green);
  border-radius: 50%;
  animation: spin .8s linear infinite;
  margin-right: 9px;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.feature-list {
  max-height: 180px;
  overflow: auto;
  display: grid;
  gap: 5px;
  margin-top: 8px;
}

.feature-item {
  border: 1px solid var(--line);
  border-radius: 8px;
  padding: 7px;
  font-size: 11px;
  text-align: left;
  background: #fff;
}

.feature-item:hover { background: #f2f5f0; }

.ai-box {
  display: grid;
  gap: 7px;
}

.ai-box textarea {
  resize: vertical;
  min-height: 76px;
}

.pill {
  display: inline-block;
  border-radius: 99px;
  background: #e8eee8;
  padding: 3px 7px;
  font-size: 10px;
  color: #34513e;
}

.maplibregl-ctrl-group {
  border-radius: 10px !important;
  overflow: hidden;
}

.maplibregl-ctrl-attrib { font-size: 10px; }

max-width: 850px {
  .app-header {
    align-items: flex-start;
    flex-direction: column;
    padding: 10px 12px;
  }

  .top-actions { width: 100%; }

  main {
    grid-template-columns: 1fr;
    height: calc(100dvh - 110px);
  }

  .sidebar {
    position: absolute;
    z-index: 8;
    top: 110px;
    left: 0;
    width: min(320px, 88vw);
    max-height: calc(100dvh - 110px);
    display: none;
    box-shadow: 5px 0 18px #0001;
  }

  .sidebar.open { display: block; }
  .mobile-only { display: inline-flex !important; }
}

.mobile-only { display: none; }
</style>
</head>

<body>

<header class="app-header">
  <div>
    <div class="brand">
      GOROD.RU
      <span style="font-weight:500;color:#7a817a">STUDIO</span>
    </div>
    <div class="subtitle">
      Карта · анализ участка · тематические маски · ИИ-помощник
    </div>
  </div>

  <div class="top-actions">
    <button id="togglePanel" class="mobile-only">☰ Панель</button>
    <button id="newProject">＋ Новый</button>
    <button id="saveProject" class="primary">Сохранить</button>
    <button id="exportPng">PNG</button>
    <button id="exportGeo">GeoJSON</button>
    <button id="exportProject">Проект JSON</button>
    <button id="importProject">Открыть</button>
    <input id="fileInput" type="file" accept="application/json,.json" hidden>
  </div>
</header>

<main>
<aside class="sidebar" id="sidebar">

  <section class="section">
    <h2>Поиск адресов и объектов</h2>
    <div class="field">
      <input id="searchInput" placeholder="Улица, дом, парк, сад, лес…">
      <button id="searchBtn">Найти</button>
    </div>

    <div class="two" style="margin-top:7px">
      <button id="parksBtn">Парки и леса в районе</button>
      <button id="clearPlaces">Убрать метки</button>
    </div>

    <p class="small">
      Поиск адресов — Nominatim. Список парков, садов и лесов вокруг карты —
      OpenStreetMap через Overpass. Полнота названий зависит от картографических данных.
    </p>

    <div id="placesList" class="feature-list"></div>
  </section>

  <section class="section">
    <h2>Быстрый переход</h2>
    <div class="cities" id="cities"></div>
  </section>

  <section class="section">
    <h2>Слои карты</h2>
    <div class="checklist">
      <label><input type="checkbox" id="roads" checked> Дороги и транспорт</label>
      <label><input type="checkbox" id="buildings" checked> Здания</label>
      <label><input type="checkbox" id="green" checked> Озеленение / землепользование</label>
      <label><input type="checkbox" id="water" checked> Водоёмы и реки</label>
      <label><input type="c


heckbox" id="labels" checked> Подписи</label>
      <label><input type="checkbox" id="threeD"> 3D-здания (тяжёлый режим)</label>
    </div>
    <p class="small">
      Слои управляют теми объектами, которые предоставляет текущий стиль карты.
    </p>
  </section>

  <section class="section">
    <h2>Редактирование участка</h2>

    <div class="btn-grid">
      <button id="drawPolygon">＋ Нарисовать участок</button>
      <button id="drawLine">／ Нарисовать линию</button>
      <button id="drawPoint">● Поставить точку</button>
      <button id="editMode">✎ Редактировать</button>
      <button id="deleteSelected" class="danger">Удалить выбранное</button>
      <button id="finishDraw">Завершить рисунок</button>
    </div>

    <div class="color-row">
      <label for="maskColor" style="font-size:12px">Цвет маски</label>
      <input type="color" id="maskColor" value="#e5a64b">
    </div>

    <div class="range-row">
      <label for="maskOpacity">Прозрачность заливки</label>
      <span id="opacityValue">35%</span>
      <input id="maskOpacity" type="range" min="5" max="90" value="35"
             style="grid-column:1/-1">
    </div>

    <div class="field" style="margin-top:8px">
      <input id="maskName" placeholder="Название маски / зоны">
      <button id="applyMask">Применить</button>
    </div>

    <p class="small">
      Рисуйте полигон участка, линию улицы или точку интереса.
      В режиме редактирования можно перемещать вершины.
      Маски и рисунки сохраняются в GeoJSON/проекте.
    </p>

    <div id="drawStats" class="result">
      Выберите или нарисуйте полигон, чтобы рассчитать площадь.
    </div>
  </section>

  <section class="section">
    <h2>Градостроительный анализ</h2>

    <div class="checklist">
      <label><input type="checkbox" id="analysisBuildings" checked> Считать здания на карте</label>
      <label><input type="checkbox" id="analysisGreen" checked> Учитывать зелёные зоны</label>
      <label><input type="checkbox" id="analysisRoads" checked> Учитывать дороги</label>
    </div>

    <div class="btn-grid" style="margin-top:8px">
      <button id="runAnalysis" class="primary">Анализ участка</button>
      <button id="bufferTool">Буфер 100 м</button>
    </div>

    <div class="result" id="analysisResult">
      Нарисуйте полигон и нажмите «Анализ участка».
    </div>

    <p class="small">
      Это предварительный картографический анализ видимых объектов,
      а не юридическое заключение и не полноценная ГИС-экспертиза.
    </p>
  </section>

  <section class="section">
    <h2>Проект</h2>
    <input type="text" id="projectName" value="Градостроительный анализ" maxlength="80">
    <p class="small">
      Камера, маски, рисунки и настройки слоёв сохраняются в проекте JSON.
    </p>
  </section>

  <section class="section">
    <h2>ИИ-помощник <span class="pill">бета</span></h2>

    <div class="ai-box">
      <textarea id="aiQuestion"
        placeholder="Например: предложи анализ доступности парка и связности пешеходных маршрутов…"></textarea>
      <button id="askAI" class="primary">Подготовить запрос для ИИ</button>
      <button id="copyAIPrompt">Скопировать запрос</button>
    </div>

    <p class="small">
      Кнопка подготовит контекст проекта и откроет ChatGPT для отправки запроса.
      Для встроенного ИИ-чата прямо в приложении нужен сервер и безопасное
      подключение к API — ключ нельзя размещать в HTML.
    </p>
  </section>

</aside>

<section class="map-wrap">
  <div id="map"></div>
  <div class="loading" id="loading">
    <span class="spinner"></span>
    <span id="loadingText">Загружаем карту…</span>
  </div>
  <div class="status" id="status" role="status">Подключение к карте…</div>
</section>
</main>

<script src="https://unpkg.com/maplibre-gl@5.12.0/dist/maplibre-gl.js"></script>
<script src="https://unpkg.com/@mapbox/mapbox-gl-draw@1.5.0/dist/mapbox-gl-draw.js"></script>
<script src="https://unpkg.com/@turf/turf@7.2.0/turf.min.js"></script>

<script>
(() => {
'use strict';

co


nst $ = id => document.getElementById(id);

const STYLE_URL = 'https://tiles.openfreemap.org/styles/liberty';

const CITIES = {
  'Новосибирск': [82.9204, 55.0302],
  'Москва': [37.6173, 55.7558],
  'Санкт-Петербург': [30.3351, 59.9343],
  'Екатеринбург': [60.5975, 56.8389],
  'Казань': [49.1064, 55.7961],
  'Красноярск': [92.8526, 56.0153],
  'Омск': [73.3686, 54.9885],
  'Тюмень': [65.5343, 57.153],
  'Талдыкорган': [78.3739, 45.0156],
  'Самара': [50.1002, 53.1959],
  'Пермь': [56.2294, 58.0105],
  'Уфа': [55.9587, 54.7388]
};

let map = null;
let mapReady = false;
let draw = null;
let activeCity = 'Новосибирск';
let searchController = null;
let placesController = null;
let placeMarkers = [];
let analysisBuffer = null;

const setStatus = (s, error = false) => {
  $('status').textContent = s;
  $('status').classList.toggle('error', error);
};

const slug = s =>
  String(s || 'gorodru')
    .toLowerCase()
    .replace(/[^a-zа-яё0-9_-]+/gi, '-')
    .replace(/^-+|-+$/g, '') || 'gorodru';

const safeName = s =>
  String(s || 'Градостроительный анализ').slice(0, 80);

const hideLoading = () => $('loading').classList.add('hidden');

const showLoading = s => {
  $('loadingText').textContent = s;
  $('loading').classList.remove('hidden');
};

Object.keys(CITIES).forEach(name => {
  const b = document.createElement('button');
  b.textContent = name;
  b.addEventListener('click', () => goCity(name));
  $('cities').appendChild(b);
});

function createMap() {
  if (!window.maplibregl) {
    hideLoading();
    setStatus('MapLibre не загрузился. Проверьте доступ к unpkg.com.', true);
    return;
  }

  try {
    map = new maplibregl.Map({
      container: 'map',
      style: STYLE_URL,
      center: CITIES[activeCity],
      zoom: 12,
      minZoom: 2,
      maxZoom: 20,
      fadeDuration: 0,
      refreshExpiredTiles: false,
      cooperativeGestures: true,
      preserveDrawingBuffer: true,
      maxTileCacheSize: 80,
      trackResize: true
    });

    map.addControl(
      new maplibregl.NavigationControl({ showCompass: true }),
      'top-right'
    );

    map.addControl(
      new maplibregl.ScaleControl({ maxWidth: 120, unit: 'metric' }),
      'bottom-right'
    );

    const timeout = setTimeout(() => {
      if (!mapReady) {
        hideLoading();
        setStatus(
          'Карта не загрузилась за 18 секунд. Проверьте сеть или сервер тайлов.',
          true
        );
      }
    }, 18000);

    map.on('load', () => {
      clearTimeout(timeout);
      mapReady = true;
      hideLoading();
      setupDraw();
      applyLayerVisibility();
      addMaskLayers();
      setStatus('Карта загружена · ' + activeCity);
    });

    map.on('error', e => {
      const m = e?.error?.message || 'ошибка сетевого запроса';
      setStatus('Ошибка карты: ' + m, true);
    });

  } catch (e) {
    hideLoading();
    setStatus('Ошибка запуска: ' + e.message, true);
  }
}

function category(l) {
  const id = (l.id || '').toLowerCase();
  const src = (l['source-layer'] || '').toLowerCase();
  const s = id + ' ' + src;

  if (/label|place|housenumber|poi|road[_-]?name|water[_-]?name|settlement|name-/.test(id)) return 'labels';
  if (/road|transportation|street|highway|bridge|tunnel|path|railway|ferry/.test(s)) return 'roads';
  if (/water|river|lake|ocean|waterway|marine/.test(s)) return 'water';
  if (/park|green|landcover|landuse|wood|grass|forest|garden|vegetation/.test(s)) return 'green';
  if (/building/.test(s)) return 'buildings';

  return null;
}

function applyLayerVisibility() {
  if (!map || !map.isStyleLoaded()) return;

  ['roads', 'buildings', 'green', 'water', 'labels'].forEach(c => {
    const on = $(c).checked;

    map.getStyle().layers.forEach(l => {
      if (category(l) === c && map.getLayer(l.id)) {
        try {
          map.setLayoutProperty(l.id, 'visibility', on ? 'visible' : 'none');
        } catch (_) {}
      }
    });
  });

  if ($('threeD').checked) {
    add3D();
  } else if (map.getLayer('gorod-3d')) {


map.setLayoutProperty('gorod-3d', 'visibility', 'none');
  }
}

['roads', 'buildings', 'green', 'water', 'labels'].forEach(id => {
  $(id).addEventListener('change', applyLayerVisibility);
});

function add3D() {
  if (!map || !map.isStyleLoaded()) return;

  if (map.getLayer('gorod-3d')) {
    map.setLayoutProperty('gorod-3d', 'visibility', 'visible');
    return;
  }

  const srcs = map.getStyle().sources || {};
  const sid = Object.keys(srcs).find(id => srcs[id].type === 'vector');

  if (!sid) {
    setStatus('Не найден векторный источник для 3D.', true);
    $('threeD').checked = false;
    return;
  }

  const bl = map.getStyle().layers.find(
    l => l.source === sid && /building/i.test(l['source-layer'] || '')
  );

  if (!bl) {
    setStatus('В этом стиле не найден слой зданий.', true);
    $('threeD').checked = false;
    return;
  }

  try {
    map.addLayer({
      id: 'gorod-3d',
      type: 'fill-extrusion',
      source: sid,
      'source-layer': bl['source-layer'],
      minzoom: 14,
      paint: {
        'fill-extrusion-color': '#b8c2b7',
        'fill-extrusion-height': [
          'coalesce', ['get', 'render_height'], ['get', 'height'], 8
        ],
        'fill-extrusion-base': [
          'coalesce', ['get', 'render_min_height'], ['get', 'min_height'], 0
        ],
        'fill-extrusion-opacity': 0.85
      }
    });

    setStatus('3D-здания включены · приблизительные высоты');

  } catch (e) {
    $('threeD').checked = false;
    setStatus('Не удалось включить 3D: ' + e.message, true);
  }
}

$('threeD').addEventListener('change', () => {
  if ($('threeD').checked) {
    add3D();
  } else if (map?.getLayer('gorod-3d')) {
    map.setLayoutProperty('gorod-3d', 'visibility', 'none');
  }
});

function goCity(n) {
  if (!map) return;

  activeCity = n;
  showLoading('Перемещаем карту…');

  map.flyTo({
    center: CITIES[n],
    zoom: 12,
    duration: 400
  });

  map.once('moveend', () => {
    hideLoading();
    setStatus('Город: ' + n);
  });
}

$('togglePanel').addEventListener('click', () => {
  $('sidebar').classList.toggle('open');
});

function setupDraw() {
  if (!window.MapboxDraw) {
    setStatus('Инструменты рисования не загрузились. Проверьте unpkg.com.', true);
    return;
  }

  draw = new MapboxDraw({
    displayControlsDefault: false,
    controls: {},
    defaultMode: 'simple_select',
    styles: [
      {
        id: 'gl-draw-polygon-fill',
        type: 'fill',
        filter: ['all', ['==', '$type', 'Polygon'], ['!=', 'mode', 'static']],
        paint: {
          'fill-color': ['coalesce', ['get', 'maskColor'], '#e5a64b'],
          'fill-outline-color': ['coalesce', ['get', 'maskColor'], '#b67b28'],
          'fill-opacity': ['coalesce', ['get', 'maskOpacity'], 0.35]
        }
      },
      {
        id: 'gl-draw-polygon-fill-static',
        type: 'fill',
        filter: ['all', ['==', '$type', 'Polygon'], ['==', 'mode', 'static']],
        paint: {
          'fill-color': ['coalesce', ['get', 'maskColor'], '#e5a64b'],
          'fill-outline-color': ['coalesce', ['get', 'maskColor'], '#b67b28'],
          'fill-opacity': ['coalesce', ['get', 'maskOpacity'], 0.35]
        }
      },
      {
        id: 'gl-draw-polygon-stroke',
        type: 'line',
